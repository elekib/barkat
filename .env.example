# Copy to .env and fill in. Never commit .env.

# Port for the web UI and API.
BARKAT_PORT=3040

# User and group the server runs as; they own everything in ./data. The
# container starts as root only to fix ownership, then drops to this user.
PUID=1000
PGID=1000

# Timezone, e.g. America/New_York
TZ=

# There is no default login. On first start Barkat prints a one-time setup code
# to its log; open the UI and use it to create the admin account:
#   docker logs barkat 2>&1 | grep -i "setup code"

# Optional: session signing secret, 32+ characters (openssl rand -hex 32).
# Leave empty to generate one on first start and store it in the database.
BARKAT_AUTH_SECRET=

# Public URL you reach Barkat at, e.g. https://barkat.example.com (needed behind a
# reverse proxy; https marks the session cookie Secure).
BARKAT_BASE_URL=

# Set to true to always mark the session cookie Secure (when BARKAT_BASE_URL is not set).
BARKAT_COOKIE_SECURE=

# Comma-separated extra origins trusted by the sign-in origin check, for a
# reverse proxy that rewrites Host. Leave empty when you reach Barkat directly.
BARKAT_ALLOWED_ORIGINS=

# Image tag to deploy: latest, dev, or a release version
BARKAT_TAG=latest
